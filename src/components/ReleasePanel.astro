---
import { render, type CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';
import BandcampPlayer from './BandcampPlayer.astro';
import CtaButton from './CtaButton.astro';
import { dateParts } from '../lib/dates';

interface Props { release: CollectionEntry<'releases'>; hidden?: boolean; headingLevel?: 'h1' | 'h3' }
const { release, hidden = false, headingLevel = 'h3' } = Astro.props;
const r = release.data;
const { Content } = await render(release);
const Heading = headingLevel;
const typeLabel = r.type === '2-track' ? 'Two-track release' : r.type;
// Text blocks from Pages CMS: a blank line starts a new paragraph.
const paragraphs = (text: string) => text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---
<article class="release-panel" id={`release-${release.id}`} data-panel={release.id} hidden={hidden}>
  <Cover title={r.title} cover={r.cover} tint={r.tint} size="large" />
  <div class="release-panel__body">
    <p class="meta">{typeLabel}, released {dateParts(r.date).long}</p>
    <Heading class="release-panel__title">{r.title}</Heading>
    {r.summary && <div class="release-panel__text">{paragraphs(r.summary).map((p) => <p>{p}</p>)}</div>}
    <BandcampPlayer title={r.title} id={r.bandcamp_embed.id} kind={r.bandcamp_embed.type} tracks={r.tracks.length} />
    {r.tracks.length > 0 && (
      <ol class="tracklist">
        {r.tracks.map((t) => <li>{t}</li>)}
      </ol>
    )}
    <div class="credits"><Content /></div>
    {r.text_block_2 && <div class="release-panel__text">{paragraphs(r.text_block_2).map((p) => <p>{p}</p>)}</div>}
    <CtaButton icon={r.cta?.icon} text={r.cta?.text} url={r.cta?.url} />
    <p class="release-panel__links">
      {r.bandcamp_url && <a href={r.bandcamp_url}>Listen / Buy on Bandcamp</a>}
      {r.spotify_url && <a href={r.spotify_url}>Stream on Spotify</a>}
    </p>
  </div>
</article>
