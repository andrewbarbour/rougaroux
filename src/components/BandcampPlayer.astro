---
import site from '../data/site.json';

interface Props { title: string; id?: string; kind?: 'none' | 'album' | 'track'; url?: string; tracks?: number }
const { title, id = '', kind = 'none', url = '', tracks = 1 } = Astro.props;

// Colours from Site settings → Bandcamp player colours. Bandcamp honours any link colour, but for the
// background it only has a light and a dark theme (other bgcol values snap to one of them) and it
// picks the plain text colour to suit. "Blend with page" is transparent over the release panel.
const hex = (v: unknown) => (typeof v === 'string' && /^#?[0-9a-f]{6}$/i.test(v.trim()) ? v.trim().replace('#', '') : '');
const colours = (site as { bandcamp_player?: { background?: string; link?: string } }).bandcamp_player ?? {};
const customBg = { Dark: '333333', Light: 'ffffff' }[colours.background ?? ''] ?? '';
const link = hex(colours.link) || 'b49cff';
// Bandcamp's "Share / Embed" dialog shows the numeric album or track id in the embed code.
const showList = kind === 'album' && tracks > 1;
// Tracks use Bandcamp's slim one-line player.
const slim = kind === 'track';
const height = slim ? 42 : showList ? Math.min(120 + tracks * 33, 472) : 120;
// Without a custom background the player is transparent over the panel; bgcol then only tells
// Bandcamp the page is dark so it uses light text.
const bg = customBg || (slim ? '0e0c10' : '16121a');
// artwork=none: the release panel already shows the cover next to the player.
// kind 'none' skips the embed, even with an ID filled in; the fallback link shows instead.
const src = id && kind !== 'none'
  ? `https://bandcamp.com/EmbeddedPlayer/${kind}=${id}/size=${slim ? 'small' : 'large'}/bgcol=${bg}/linkcol=${link}/artwork=none/tracklist=${showList}/transparent=${!customBg}/`
  : '';
---
{src ? (
  <iframe class="bc-player" style={`height:${height}px${customBg ? `;background:#${customBg}` : ''}`} src={src} title={`${title} on Bandcamp`} loading="lazy" seamless></iframe>
) : url ? (
  <a class="bc-fallback" href={url}>
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>
    <span>Play {title} on Bandcamp</span>
  </a>
) : null}
