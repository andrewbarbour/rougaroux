---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ReleasePanel from '../../components/ReleasePanel.astro';

export async function getStaticPaths() {
  const releases = await getCollection('releases');
  return releases.map((release) => ({ params: { slug: release.id }, props: { release } }));
}
interface Props { release: CollectionEntry<'releases'> }
const { release } = Astro.props;
// Text Block 1 can hold several paragraphs; the first one makes the page description.
const description = release.data.summary.split(/\n\s*\n/)[0].replace(/\s+/g, ' ').trim();
---
<Base title={release.data.title} description={description || `${release.data.title} by Rougaroux.`} image={release.data.cover || undefined}>
  <section class="section wrap">
    <p><a class="back" href="/#music">All music</a></p>
    <ReleasePanel release={release} headingLevel="h1" />
  </section>
</Base>
