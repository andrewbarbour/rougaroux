---
import '@fontsource/pirata-one/400.css';
import '@fontsource/unifrakturmaguntia/400.css';
import '@fontsource/metal-mania/400.css';
import '@fontsource/new-rocker/400.css';
import '@fontsource/creepster/400.css';
import '@fontsource/special-elite/400.css';
import '@fontsource/bebas-neue/400.css';
import '@fontsource/anton/400.css';
import '@fontsource/archivo/latin-400.css';
import '@fontsource/archivo/latin-500.css';
import '@fontsource/archivo/latin-700.css';
import '@fontsource/archivo/latin-800.css';
import '@fontsource/archivo/latin-ext-400.css';
import '@fontsource/archivo/latin-ext-700.css';
import '@fontsource/noto-sans/latin-ext-400.css';
import '@fontsource/noto-sans/greek-400.css';
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/space-mono/latin-700.css';
import '../styles/global.css';
import site from '../data/site.json';
import { displayFont } from '../lib/fonts';

interface Props { title?: string; description?: string; image?: string }
const { title, description = `${site.name}: ${site.tagline} From Vancouver, BC.`, image = site.hero_image } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
// Pages CMS drops empty fields on save, so any menu label may be missing.
const menu: Partial<Record<'music' | 'shows' | 'about' | 'contact' | 'button_text' | 'button_link', string>> = site.menu ?? {};
const font = displayFont((site as { display_font?: string }).display_font);
const home = Astro.url.pathname === '/' ? '' : '/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#0e0c10" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <style set:html={`:root{--accent:${site.accent};--display:${font.family};--display-scale:${font.scale}}`}></style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="wordmark" href="/">{site.name}</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line></svg>
      <span class="sr-only">Menu</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <a href={`${home}#music`}>{menu.music || 'Music'}</a>
      <a href={`${home}#shows`}>{menu.shows || 'Shows'}</a>
      <a href={`${home}#about`}>{menu.about || 'About'}</a>
      <a href={`${home}#contact`}>{menu.contact || 'Contact'}</a>
      <a class="btn btn--solid" href={menu.button_link || site.links.bandcamp}>{menu.button_text || 'Listen on Bandcamp'}</a>
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <p class="land">{site.land_acknowledgement}</p>
    <p class="small">© {new Date().getFullYear()} {site.name}</p>
  </footer>

  <script>
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = document.getElementById('site-nav');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      nav?.classList.toggle('is-open', !open);
    });
    nav?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) {
        toggle?.setAttribute('aria-expanded', 'false');
        nav.classList.remove('is-open');
      }
    });
  </script>
</body>
</html>
